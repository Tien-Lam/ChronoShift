{
  "description": "Redirect www to the canonical Time to Local domain",
  "ref": "chronoshift_www_canonical",
  "expression": "(http.host eq \"www.timetolocal.com\")",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 301,
      "target_url": {
        "expression": "concat(\"https://timetolocal.com\", http.request.uri.path)"
      },
      "preserve_query_string": true
    }
  },
  "enabled": true
}
