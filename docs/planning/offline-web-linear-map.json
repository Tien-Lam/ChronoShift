  "milestones": {
    "foundation/baseline": {
      "id": "563034f1-6adb-4c03-8656-cba38ec9b8df",
      "name": "Contract & browser baseline",
      "description": "Conversion/UX contract recorded, reproducible web scaffold builds, portable exact fixtures exist, and the timezone adapter works on the target browser matrix.",
      "progress": 0,
      "sortOrder": 65
    },
    "foundation/parity": {
      "id": "4a977be3-d961-4b27-b91c-045d0e34d1c1",
      "name": "Conversion parity",
      "description": "Real browser parser passes the approved fixture set: date context/ranges/order, fixed offsets vs IANA DST, supported cities and Unix seconds, ambiguity and deduplication. Cancellation and input limits are verified.",
      "progress": 0,
      "sortOrder": 1162
    },
    "experience/usable": {
      "id": "015e5e0e-88d6-40ee-a77a-481b10521575",
      "name": "Usable conversion flow",
      "description": "The responsive core page converts real input, shows original text and local date/time/zone, makes ambiguous options clear, and provides a searchable timezone override.",
      "progress": 0,
      "sortOrder": -57
    },
    "experience/polish": {
      "id": "0569b268-af61-4fd2-8309-ec07ae448c40",
      "name": "Accessible, low-friction experience",
      "description": "Copy/paste fallbacks, errors and correction, empty/large-input states, keyboard/screen reader support and a small task-based usability check all pass.",
      "progress": 0,
      "sortOrder": 861
    },
    "offline/ready": {
      "id": "022a0291-2b00-406e-9ac8-955c84e8639c",
      "name": "Offline-ready PWA",
      "description": "App shell/parser/data are cached, readiness is accurate, the app reopens and converts fresh input without networking, preferences survive normal restarts, and installation works where supported.",
      "progress": 0,
      "sortOrder": 14
    },
    "offline/resilient": {
      "id": "5ce0ae4b-2370-45b9-b87b-3ef5c6977d04",
      "name": "Safe updates & offline entry points",
      "description": "Version updates cannot mix incompatible assets or erase active input; supported installed share targets work offline through POST, and offline/storage/upgrade regressions are covered.",
      "progress": 0,
      "sortOrder": 915
    },
    "delivery/candidate": {
      "id": "dd4052cc-9fd3-4bc9-8366-d9921b9f7f19",
      "name": "Web release candidate",
      "description": "Web CI, exact browser acceptance, offline checks, accessibility evidence, performance budgets and privacy audit pass with no unresolved conversion correctness defects.",
      "progress": 0,
      "sortOrder": -1
    },
    "delivery/cutover": {
      "id": "897e485b-5c7b-4ee1-8769-df0af789a3aa",
      "name": "Web-only delivery",
      "description": "Web-only source, build, publishing, dependencies and documentation; native maintenance retired with historical provenance preserved.",
      "progress": 0,
      "sortOrder": 1032
    }
